modules = ["bash", "web", "nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
EXPO_PUBLIC_API_BASE_URL = "https://dev-api.myhikayat.app"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mobile Expo Web"

[[workflows.workflow]]
name = "Mobile Expo Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "corepack pnpm --filter mobile exec expo start --web --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001
