# Dedicated mobile/UI E2E backend (NOT development, NOT production).
# Copy to backend/.env.e2e and fill secrets. Never commit .env.e2e.

APP_ENV=test
APP_PORT=3001
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
APP_CHECKOUT_RETURN_ORIGINS=reader://,http://localhost:3000,http://localhost:5173,http://localhost:8081
APP_PUBLIC_ORIGIN=http://localhost:8081

# Dedicated PostgreSQL database — do not reuse development or production DBs.
DATABASE_URL=postgresql://abdshammout@localhost:5432/lib_app_e2e?schema=public

# Use distinct secrets from development/production.
JWT_ACCESS_SECRET=e2e-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=1h
JWT_RECOVERY_SECRET=e2e-recovery-secret-change-me
JWT_RECOVERY_EXPIRES_IN=1h

STORAGE_BUCKET=my-hikayat-platform-e2e
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_ID=e2e-key-1
ENCRYPTION_PREVIOUS_KEYS=

STRIPE_SECRET_KEY=sk_test_e2e_placeholder
STRIPE_WEBHOOK_SECRET=whsec_e2e_placeholder
STRIPE_PRICE_ID=price_e2e_placeholder
PLATFORM_CUT_PERCENT=30

MAIL_FROM=noreply@example.com
MAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
MAIL_SMTP_PORT=2525
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=e2e
MAIL_SMTP_PASSWORD=e2e

# Seeded mobile E2E reader (password is local-only; keep out of Maestro YAML).
E2E_READER_EMAIL=e2e-reader@example.test
E2E_READER_PASSWORD=correct-horse-battery-e2e
