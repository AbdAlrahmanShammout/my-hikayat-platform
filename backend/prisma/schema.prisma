generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  reader
  author
  admin
}

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique
  passwordHash             String
  role                     UserRole                  @default(reader)
  isPublisher              Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  books                    Book[]
  readingProgresses        ReadingProgress[]
  readingBookmarks         ReadingBookmark[]
  readingSessions          ReadingSession[]
  readingVisualEngagements ReadingVisualEngagement[]
  subscription             Subscription?
}

model Category {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  categoryWeight Decimal  @default(1.0000) @db.Decimal(10, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  books          Book[]
}

enum BookLayoutType {
  reflowable
  fixed_layout
}

enum BookType {
  standard_chapter
  picture_book
  illustrated_chapter
}

enum BookPublishingStatus {
  pending
  in_review
  approved
  rejected
}

enum BookProcessingStatus {
  not_started
  processing
  ready
  failed
}

model Book {
  id                Int                   @id @default(autoincrement())
  title             String
  description       String                @db.Text
  layoutType        BookLayoutType?
  bookType          BookType
  publishingStatus  BookPublishingStatus  @default(pending)
  processingStatus  BookProcessingStatus  @default(not_started)
  publishedAt       DateTime?
  ownerId           Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  owner             User                  @relation(fields: [ownerId], references: [id])
  categories        Category[]
  assets            BookAsset[]
  sourceMetadata    BookSourceMetadata?
  chapters          BookChapter[]
  pages             BookPage[]
  spreads           BookSpread[]
  pageTextLayers    BookPageTextLayer[]
  readingProgresses        ReadingProgress[]
  readingBookmarks         ReadingBookmark[]
  readingSessions          ReadingSession[]
  readingVisualEngagements ReadingVisualEngagement[]
  collectionBooks          CollectionBook[]
  bookEngagements          BookEngagement[]

  @@index([publishingStatus])
  @@index([processingStatus])
  @@index([publishedAt])
  @@index([ownerId])
}

enum BookAssetKind {
  source
  processed
  preview_image
  promo_video
  audio
}

model BookAsset {
  id               Int           @id @default(autoincrement())
  bookId           Int
  kind             BookAssetKind
  storageKey       String        @unique
  contentType      String
  byteSize         Int
  checksumSha256   String?
  originalFileName String?
  sortOrder        Int           @default(0)
  isEncrypted      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  book             Book          @relation(fields: [bookId], references: [id])

  @@index([bookId])
  @@index([bookId, kind])
}

model BookSourceMetadata {
  id          Int       @id @default(autoincrement())
  bookId      Int       @unique
  packagePath String
  epubVersion String
  identifier  String
  title       String
  language    String
  creator     String?
  publisher   String?
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  book        Book      @relation(fields: [bookId], references: [id])
}

model BookChapter {
  id          Int       @id @default(autoincrement())
  bookId      Int
  spineIndex  Int
  href        String
  manifestId  String
  title       String
  contentText String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  book        Book      @relation(fields: [bookId], references: [id])

  @@index([bookId])
  @@index([bookId, spineIndex])
}

enum BookPageSpreadRole {
  left
  right
  center
  single
}

model BookPage {
  id            Int                 @id @default(autoincrement())
  bookId        Int
  spineIndex    Int
  href          String
  manifestId    String
  title         String
  width         Int
  height        Int
  spreadRole    BookPageSpreadRole
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  book          Book                @relation(fields: [bookId], references: [id])
  leftSpreads   BookSpread[]        @relation("BookSpreadLeftPage")
  rightSpreads  BookSpread[]        @relation("BookSpreadRightPage")
  centerSpreads BookSpread[]        @relation("BookSpreadCenterPage")
  textLayer     BookPageTextLayer?

  @@index([bookId])
  @@index([bookId, spineIndex])
}

model BookSpread {
  id           Int       @id @default(autoincrement())
  bookId       Int
  spreadIndex  Int
  leftPageId   Int?
  rightPageId  Int?
  centerPageId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  book         Book      @relation(fields: [bookId], references: [id])
  leftPage     BookPage? @relation("BookSpreadLeftPage", fields: [leftPageId], references: [id])
  rightPage    BookPage? @relation("BookSpreadRightPage", fields: [rightPageId], references: [id])
  centerPage   BookPage? @relation("BookSpreadCenterPage", fields: [centerPageId], references: [id])

  @@index([bookId])
  @@index([bookId, spreadIndex])
}

model BookPageTextLayer {
  id          Int                 @id @default(autoincrement())
  pageId      Int                 @unique
  bookId      Int
  contentText String              @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  page        BookPage            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  book        Book                @relation(fields: [bookId], references: [id])
  runs        BookPageTextRun[]

  @@index([bookId])
}

model BookPageTextRun {
  id          Int               @id @default(autoincrement())
  textLayerId Int
  sortOrder   Int
  text        String
  x           Float
  y           Float
  width       Float?
  height      Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  textLayer   BookPageTextLayer @relation(fields: [textLayerId], references: [id], onDelete: Cascade)

  @@index([textLayerId])
  @@index([textLayerId, sortOrder])
}

model ReadingProgress {
  id            Int             @id @default(autoincrement())
  userId        Int
  bookId        Int
  layoutType    BookLayoutType
  spineIndex    Int?
  scrollOffset  Int?
  spreadIndex   Int?
  pageNumber    Int?
  lastSessionAt DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  user          User            @relation(fields: [userId], references: [id])
  book          Book            @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model ReadingBookmark {
  id           Int             @id @default(autoincrement())
  userId       Int
  bookId       Int
  layoutType   BookLayoutType
  spineIndex   Int?
  scrollOffset Int?
  spreadIndex  Int?
  pageNumber   Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  user         User            @relation(fields: [userId], references: [id])
  book         Book            @relation(fields: [bookId], references: [id])

  @@index([userId])
  @@index([bookId])
  @@index([userId, bookId])
}

model ReadingSession {
  id                Int             @id @default(autoincrement())
  userId            Int
  bookId            Int
  layoutType        BookLayoutType
  startedAt         DateTime
  endedAt           DateTime?
  activeDurationMs  Int             @default(0)
  idleDurationMs    Int             @default(0)
  spineIndex        Int?
  scrollOffset      Int?
  spreadIndex       Int?
  pageNumber        Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  user              User                      @relation(fields: [userId], references: [id])
  book              Book                      @relation(fields: [bookId], references: [id])
  visualEngagements ReadingVisualEngagement[]

  @@index([userId])
  @@index([bookId])
  @@index([userId, bookId])
}

model ReadingVisualEngagement {
  id                 Int             @id @default(autoincrement())
  userId             Int
  bookId             Int
  sessionId          Int
  layoutType         BookLayoutType
  spreadIndex        Int
  pageNumber         Int
  activeDurationMs   Int             @default(0)
  visualSceneTimeMs  Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  user               User            @relation(fields: [userId], references: [id])
  book               Book            @relation(fields: [bookId], references: [id])
  session            ReadingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, spreadIndex, pageNumber])
  @@index([sessionId])
  @@index([userId, bookId])
  @@index([bookId])
}

model Collection {
  id        Int              @id @default(autoincrement())
  title     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  items     CollectionBook[]

  @@index([deletedAt])
}

model CollectionBook {
  id           Int        @id @default(autoincrement())
  collectionId Int
  bookId       Int
  displayOrder Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  collection   Collection @relation(fields: [collectionId], references: [id])
  book         Book       @relation(fields: [bookId], references: [id])

  @@unique([collectionId, bookId])
  @@index([collectionId])
  @@index([bookId])
  @@index([collectionId, displayOrder])
}

enum PlanKind {
  free
  monthly_paid
}

enum PlanInterval {
  month
}

enum SubscriptionStatus {
  active
  canceled
}

model Plan {
  id             Int            @id @default(autoincrement())
  slug           String         @unique
  name           String
  kind           PlanKind       @unique
  interval       PlanInterval?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  subscriptions  Subscription[]

  @@index([deletedAt])
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  planId               Int
  status               SubscriptionStatus @default(active)
  startedAt            DateTime
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  activatedAt          DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  user                 User               @relation(fields: [userId], references: [id])
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
}

enum RevenuePeriodStatus {
  open
  closed
}

model RevenuePeriod {
  id                   Int                  @id @default(autoincrement())
  startsAt             DateTime
  endsAt               DateTime
  status               RevenuePeriodStatus  @default(open)
  platformCutPercent   Decimal              @db.Decimal(5, 2)
  poolAmountCents      Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  bookEngagements      BookEngagement[]

  @@unique([startsAt])
  @@index([status])
  @@index([deletedAt])
}

model BookEngagement {
  id                   Int             @id @default(autoincrement())
  revenuePeriodId      Int
  bookId               Int
  layoutType           BookLayoutType
  activeReadingMs      Int             @default(0)
  activeSpreadMs       Int             @default(0)
  visualSceneTimeMs    Int             @default(0)
  categoryWeight       Decimal         @db.Decimal(10, 4)
  weightedEngagement   Decimal         @db.Decimal(20, 8)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  revenuePeriod        RevenuePeriod   @relation(fields: [revenuePeriodId], references: [id])
  book                 Book            @relation(fields: [bookId], references: [id])

  @@unique([revenuePeriodId, bookId])
  @@index([revenuePeriodId])
  @@index([bookId])
  @@index([deletedAt])
}
