generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  reader
  author
  admin
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(reader)
  isPublisher  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Category {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  categoryWeight Decimal  @default(1.0000) @db.Decimal(10, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  books          Book[]
}

enum BookLayoutType {
  reflowable
  fixed_layout
}

enum BookType {
  standard_chapter
  picture_book
  illustrated_chapter
}

enum BookPublishingStatus {
  pending
  in_review
  approved
  rejected
}

model Book {
  id                Int                   @id @default(autoincrement())
  title             String
  description       String                @db.Text
  layoutType        BookLayoutType?
  bookType          BookType
  publishingStatus  BookPublishingStatus  @default(pending)
  publishedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  categories        Category[]

  @@index([publishingStatus])
  @@index([publishedAt])
}
