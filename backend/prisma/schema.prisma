generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  reader
  author
  admin
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(reader)
  isPublisher  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  books        Book[]
}

model Category {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  categoryWeight Decimal  @default(1.0000) @db.Decimal(10, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  books          Book[]
}

enum BookLayoutType {
  reflowable
  fixed_layout
}

enum BookType {
  standard_chapter
  picture_book
  illustrated_chapter
}

enum BookPublishingStatus {
  pending
  in_review
  approved
  rejected
}

enum BookProcessingStatus {
  not_started
  processing
  ready
  failed
}

model Book {
  id                Int                   @id @default(autoincrement())
  title             String
  description       String                @db.Text
  layoutType        BookLayoutType?
  bookType          BookType
  publishingStatus  BookPublishingStatus  @default(pending)
  processingStatus  BookProcessingStatus  @default(not_started)
  publishedAt       DateTime?
  ownerId           Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  owner             User                  @relation(fields: [ownerId], references: [id])
  categories        Category[]
  assets            BookAsset[]
  sourceMetadata    BookSourceMetadata?
  chapters          BookChapter[]
  pages             BookPage[]
  spreads           BookSpread[]

  @@index([publishingStatus])
  @@index([processingStatus])
  @@index([publishedAt])
  @@index([ownerId])
}

enum BookAssetKind {
  source
  processed
  preview_image
  promo_video
  audio
}

model BookAsset {
  id               Int           @id @default(autoincrement())
  bookId           Int
  kind             BookAssetKind
  storageKey       String        @unique
  contentType      String
  byteSize         Int
  checksumSha256   String?
  originalFileName String?
  sortOrder        Int           @default(0)
  isEncrypted      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  book             Book          @relation(fields: [bookId], references: [id])

  @@index([bookId])
  @@index([bookId, kind])
}

model BookSourceMetadata {
  id          Int       @id @default(autoincrement())
  bookId      Int       @unique
  packagePath String
  epubVersion String
  identifier  String
  title       String
  language    String
  creator     String?
  publisher   String?
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  book        Book      @relation(fields: [bookId], references: [id])
}

model BookChapter {
  id          Int       @id @default(autoincrement())
  bookId      Int
  spineIndex  Int
  href        String
  manifestId  String
  title       String
  contentText String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  book        Book      @relation(fields: [bookId], references: [id])

  @@index([bookId])
  @@index([bookId, spineIndex])
}

enum BookPageSpreadRole {
  left
  right
  center
  single
}

model BookPage {
  id            Int                 @id @default(autoincrement())
  bookId        Int
  spineIndex    Int
  href          String
  manifestId    String
  title         String
  width         Int
  height        Int
  spreadRole    BookPageSpreadRole
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  book          Book                @relation(fields: [bookId], references: [id])
  leftSpreads   BookSpread[]        @relation("BookSpreadLeftPage")
  rightSpreads  BookSpread[]        @relation("BookSpreadRightPage")
  centerSpreads BookSpread[]        @relation("BookSpreadCenterPage")

  @@index([bookId])
  @@index([bookId, spineIndex])
}

model BookSpread {
  id           Int       @id @default(autoincrement())
  bookId       Int
  spreadIndex  Int
  leftPageId   Int?
  rightPageId  Int?
  centerPageId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  book         Book      @relation(fields: [bookId], references: [id])
  leftPage     BookPage? @relation("BookSpreadLeftPage", fields: [leftPageId], references: [id])
  rightPage    BookPage? @relation("BookSpreadRightPage", fields: [rightPageId], references: [id])
  centerPage   BookPage? @relation("BookSpreadCenterPage", fields: [centerPageId], references: [id])

  @@index([bookId])
  @@index([bookId, spreadIndex])
}
