# Public API origin for the NestJS backend (no trailing slash).
# Expo only embeds variables prefixed with EXPO_PUBLIC_.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Ed25519 public key used to validate server-issued offline reading leases.
# Format: raw Ed25519 public key bytes encoded as base64url.
EXPO_PUBLIC_OFFLINE_LEASE_PUBLIC_KEY=
